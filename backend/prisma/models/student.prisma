// ============================================
// Student — belongs to Branch, linked to User
// ============================================

model Student {
  id String @id @default(cuid())

  // Foreign key to Branch
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // user id (Optional until admission is approved and user is created)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Identification
  enrollmentNo  String? @unique // Generated after admission approval
  applicationNo String? @unique // From admission form e.g., APP2024006

  // Personal Info
  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  bloodGroup  String?
  category    String?
  religion    String?
  nationality String   @default("Indian")

  aadharNumber String?
  apaarNumber  String?

  // Contact
  phone          String
  altPhone       String?
  whatsappNumber String?
  email          String?

  // Address
  streetAddress String  @db.Text
  city          String
  state         String
  district      String?
  pincode       String
  country       String  @default("India")

  // Academic
  admissionDate DateTime @default(now())
  academicYear  String?
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  batchId       String?
  batch         Batch?   @relation(fields: [batchId], references: [id])

  // Previous Education - 10th Standard
  tenthSchoolName    String?
  tenthBoard         String?
  tenthYearOfPassing Int?
  tenthPercentage    String?
  tenthRollNo        String?
  tenthSubjects      String?

  // Previous Education - 12th Standard
  twelfthSchoolName    String?
  twelfthBoard         String?
  twelfthYearOfPassing Int?
  twelfthPercentage    String?
  twelfthStream        String?
  twelfthSubjects      String?

  // Father's Details
  fatherName         String
  fatherOccupation   String?
  fatherPhone        String?
  fatherEmail        String?
  fatherAnnualIncome String?

  // Mother's Details
  motherName       String
  motherOccupation String?
  motherPhone      String?

  // Local Guardian Details
  localGuardianName     String?
  localGuardianRelation String?
  localGuardianPhone    String?
  localGuardianAddress  String? @db.Text

  // Documents (URLs/paths to storage)
  photo               Json?
  aadharFront         Json?
  aadharBack          Json?
  tenthMarksheet      Json?
  twelfthMarksheet    Json?
  transferCertificate Json?
  apaarCard           Json?
  casteCertificate    Json?
  admissionForm       Json?

  // Status & Timestamps
  admissionStatus AdmissionStatus @default(DRAFT)
  isActive        Boolean         @default(true)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  feeInvoices     FeeInvoice[]
  attendance      AttendanceRecord[]
  examResults     ExamResult[]

  @@index([branchId])
  @@index([courseId])
  @@index([batchId])
  @@index([enrollmentNo])
  @@index([applicationNo])
  @@map("students")
}

model Exam {
  id          String       @id @default(cuid())
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id])
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id])
  batchId     String?
  batch       Batch?       @relation(fields: [batchId], references: [id])
  name        String
  subject     String
  examDate    DateTime     @db.Date
  maxMarks    Int          @default(100)
  passMarks   Int          @default(40)
  status      ExamStatus   @default(SCHEDULED)
  results     ExamResult[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([branchId, examDate])
  @@index([courseId])
  @@map("exams")
}

model ExamResult {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  marks       Float
  remarks     String?
  gradedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_results")
}

enum ExamStatus {
  SCHEDULED
  MARKS_ENTRY
  PUBLISHED
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  PENDING_PAYMENT
  APPROVED
  REJECTED
}

model FeeInvoice {
  id          String      @id @default(cuid())
  studentId   String
  student     Student     @relation(fields: [studentId], references: [id])
  branchId    String
  invoiceNo   String      @unique
  description String
  amount      Decimal     @db.Decimal(12, 2)
  dueDate     DateTime
  status      FeeStatus   @default(DUE)
  payments    FeePayment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([studentId])
  @@index([branchId, status])
  @@map("fee_invoices")
}

model FeePayment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       FeeInvoice    @relation(fields: [invoiceId], references: [id])
  receiptNo     String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  method        FeePaymentMethod
  referenceNo   String?
  paidAt        DateTime      @default(now())
  receivedById  String
  reversedAt    DateTime?
  reversalNote  String?
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
  @@map("fee_payments")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  branchId   String
  batchId    String?
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([branchId, date])
  @@index([batchId, date])
  @@map("attendance_records")
}

enum FeeStatus {
  DUE
  PARTIAL
  PAID
  VOID
}

enum FeePaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
