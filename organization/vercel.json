{
    "rewrites": [
        {
            "source": "/computercentre/:path*",
            "destination": "/computercentre/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/:page.php",
            "destination": "/:page.html",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/computercentre/coder/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}
